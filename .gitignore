# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Local Docker Compose overrides (copy from .env.example)
.env
.certloader/

repo/
build/
bin/
.gradle/
# Node artifact files
node_modules/
dist/

.temp-execution*

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

*.iml

# Log files

*.log

# Package files
*.jar
# But allow gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
# Allow Darren's patched acme4j client (Landmark / EdDSA) when present
!acme4j/*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# E2E run artifacts (screenshots, logs) — do not commit
e2e/frontend/runs/
e2e/scripts/.e2e-lifecycle.lock
**/runs/screenshots/
*.screenshot.png
*-failure.png

# HAProxy manual maintenance flag (optional file: line `.*` triggers splash)
haproxy/state/maintenance.patterns

# Cursor Playwright skill artifacts (local-only)
.cursor/skills/playwright-skill/.temp-execution-*.js
.cursor/skills/playwright-skill/runs/

# Accidental copy of built index.html: Vite dev serves /login from this file and breaks the SPA route.
cl/login

# Shannon pentest lifecycle (generated config, credentials, run artifacts)
pentest/.env
pentest/.generated/
pentest/shannon-runs/
pentest/scripts/.shannon-lifecycle.lock
pentest/shannon-certlocker-local.yaml

# Runtime MCP fixture includes provider credentials copied from local cl data.
integration-test/data/mcp-e2e/
e2e/evidence/mcp-codex/
